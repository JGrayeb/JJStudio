# Conexión pública de Supabase para promociones (la llave publicable puede
# exponerse al navegador; la seguridad real está en las políticas RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# La integración de Vercel puede proporcionar estas variantes automáticamente:
NEXT_PUBLIC_JJStudio_SUPABASE_URL=
NEXT_PUBLIC_JJStudio_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_JJStudio_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Checkout se crea exclusivamente en el servidor. Usa de preferencia
# una llave restringida con permiso para crear y consultar Checkout Sessions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Registro interno de paquetes pagados para su activación manual en Nessty.
GOOGLE_ACTIVATION_URL=
GOOGLE_ACTIVATION_SECRET=

# Feed oficial de una cuenta profesional de Instagram. Si no están presentes,
# el sitio usa automáticamente fotografías locales de respaldo.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v24.0
